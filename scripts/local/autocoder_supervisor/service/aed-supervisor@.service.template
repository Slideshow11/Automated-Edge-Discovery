[Unit]
Description=AED Autocoder Supervisor (source-controlled)
Documentation=https://github.com/Slideshow11/Automated-Edge-Discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# All paths below are absolute. The systemd template unit
# is copied to /etc/systemd/system/aed-supervisor@.service
# and instantiated as aed-supervisor@<instance>.service.
#
# The supervisor package is installed at /opt/aed-supervisor
# (via the documented procedure in docs/INSTALL.md). The
# install root contains:
#
#     /opt/aed-supervisor/
#     ├── pyproject.toml
#     └── autocoder_supervisor/   <- the Python package
#
# ``pip install /opt/aed-supervisor`` registers the package
# in the active Python environment's site-packages, so no
# PYTHONPATH override is needed. The ExecStart uses the
# venv Python explicitly when the operator installed the
# package into a venv; substitute the appropriate path if
# the install is system-wide.
WorkingDirectory=/var/lib/aed-supervisor/%i
Environment=HOME=/var/lib/aed-supervisor/%i
Environment=PYTHONPATH=
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AED_SUPERVISOR_CONFIG=/etc/aed-supervisor/%i/aed-supervisor.toml
Environment=AED_PR_NUMBER=__SET_ME__
Environment=AED_REPO_OWNER=__SET_ME__
Environment=AED_REPO_NAME=__SET_ME__
Environment=AED_AUTHORITATIVE_HEAD=__SET_ME__
ExecStart=/usr/bin/env python3 -m autocoder_supervisor.supervisor --config /etc/aed-supervisor/%i/aed-supervisor.toml
Restart=always
RestartSec=10
# KillMode=control-group: when the service is stopped, the
# entire control group (including the worker and its
# descendants) is terminated. This prevents orphaned workers
# that linger after the supervisor dies.
KillMode=control-group
TimeoutStopSec=30
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=default.target
